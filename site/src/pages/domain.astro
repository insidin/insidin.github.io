---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Domain managed by Insidin"
  description="This domain is managed by Insidin and currently has no dedicated public website."
>
  <section class="relative bg-primary min-h-[70vh] flex items-center overflow-hidden pt-16">
    <div class="absolute inset-0 opacity-[0.04]">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>
    </div>

    <div class="relative max-w-[1100px] mx-auto px-6 py-24 w-full">
      <div class="max-w-[680px]">
        <div class="inline-flex items-center gap-2 mb-6">
          <span class="w-7 h-px bg-accent"></span>
          <span class="mono-xs text-accent">DOMAIN</span>
        </div>

        <h1 class="d-xl text-white mb-5">
          This domain is<br />
          <span class="text-accent">managed by Insidin.</span>
        </h1>

        <p class="b-l text-white/70 mb-10 max-w-[600px]">
          This domain currently has no dedicated public website.
        </p>

        <a
          href="/"
          class="inline-flex items-center gap-2 bg-accent text-primary font-semibold px-6 py-3 rounded-sm hover:opacity-90 transition-opacity"
        >
          Visit Insidin
        </a>
      </div>
    </div>
  </section>
</Layout>
---
import Layout from '../../layouts/Layout.astro';

const papers = [
  {
    title: "Governing Enterprise AI Skills",
    subtitle: "Risk, Reuse, and Control in Agentic AI",
    date: "May 2026",
    version: "1.4",
    description: "Enterprises are beginning to use AI assistants and agentic systems as reusable work environments. Employees create prompts, workflows, helper scripts, and small pieces of automation, then share them as \"skills\". This paper explores why skills create a different risk model from traditional software, and proposes a governance framework combining software lifecycle discipline with AI-specific runtime enforcement.",
    tags: ["ai-strategy", "agentic AI", "ai governance", "ai risk", "skills"],
    href: "/papers/governing-enterprise-ai-skills",
    pdfHref: "/papers/governing-enterprise-ai-skills.pdf",
  },
];
---

<Layout title="Papers - Insidin" description="In-depth papers on data, AI, governance, and enterprise architecture.">
  <section class="pt-32 pb-24 px-6">
    <div class="max-w-3xl mx-auto">
      <!-- Header -->
      <div class="mb-10">
        <div class="inline-flex items-center gap-2 mb-3">
          <span class="w-7 h-px bg-accent"></span>
          <span class="mono-xs text-accent">Papers</span>
        </div>
        <h1 class="d-xl text-primary" style="font-size:clamp(2rem,4vw,3rem)">Papers.</h1>
        <p class="b-m text-muted mt-3" style="max-width:38rem">
          In-depth papers discussing studies, frameworks or reference architectures on data, AI and data/AI governance.
        </p>
      </div>

      <!-- Papers list -->
      <div>
        {papers.map(paper => (
          <div class="py-8 border-b border-border">
            <div class="flex items-start gap-4 mb-3">
              <div class="w-10 h-10 bg-surface flex items-center justify-center shrink-0" style="border-radius:var(--radius-sm)">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                </svg>
              </div>
              <div>
                <a href={paper.href} class="d-m text-primary hover:text-accent transition-colors" style="line-height:1.4">
                  {paper.title}
                </a>
                <p class="b-s text-muted mt-0.5">{paper.subtitle}</p>
              </div>
            </div>

            <p class="b-m text-muted mb-4" style="line-height:1.7">{paper.description}</p>

            <div class="flex items-center gap-3 flex-wrap">
              <span class="mono-xs text-muted">{paper.date}</span>
              <span class="text-border">|</span>
              <span class="mono-xs text-muted">v{paper.version}</span>

              {paper.tags.map(tag => (
                <span class="mono-xs px-2 py-0.5 bg-surface text-muted" style="border-radius:9999px;font-size:0.6rem">{tag}</span>
              ))}

              <a
                href={paper.pdfHref}
                target="_blank"
                class="ml-auto inline-flex items-center gap-1.5 mono-xs text-accent hover:text-primary transition-colors"
                style="font-size:0.65rem"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
                PDF
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
